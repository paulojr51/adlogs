# URL da API central (heartbeat, configuração e envio de eventos)
API_URL=http://localhost:3001

# Chave deste servidor — gerada no painel de Servidores.
# É por ela que a API resolve a qual servidor os eventos pertencem.
# Sem ela o coletor sobe, avisa no log e não envia nada.
SERVER_API_KEY=

# Intervalo de coleta em segundos (padrão: 30)
POLL_INTERVAL=30

# Versão do coletor
COLLECTOR_VERSION=2.1.0

# Nome do serviço Windows
SERVICE_NAME=ADLogsCollector
SERVICE_DISPLAY_NAME=ADLogs - Coletor de Auditoria
SERVICE_DESCRIPTION=Coleta eventos de login e acesso a arquivos do Windows Event Log.
