# Normaliza quebras de linha: repositório usa LF, Windows converte localmente
* text=auto eol=lf

# Arquivos de texto explícitos — sempre LF
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.prisma    text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.sh        text eol=lf
*.py        text eol=lf
*.toml      text eol=lf
*.txt       text eol=lf
*.sql       text eol=lf

# Scripts Windows — mantém CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Binários — sem conversão
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.pdf       binary
